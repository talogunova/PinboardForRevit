<Window x:Class="Pinboard.UI.SelectSchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinboard - Select Schedules"
        Width="420"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="Select schedules for this batch"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,12"/>

        <!-- SCHEDULE LIST -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScheduleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <CheckBox IsChecked="{Binding IsChecked}"
                                      Content="{Binding Name}"
                                      FontSize="13"
                                      Foreground="#2C3E50"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- BATCH NAME -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Batch name"
                       FontSize="12"
                       Foreground="#7F8C8D"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="BatchNameBox"
                     FontSize="13"
                     Padding="8,6"/>
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Foreground="#C0392B"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="SaveButton"
                    Content="Save Batch"
                    Width="100" Height="30"
                    FontSize="12"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"/>
            <Button Content="Cancel"
                    Width="80" Height="30"
                    FontSize="12"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
