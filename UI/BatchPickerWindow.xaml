<Window x:Class="Pinboard.UI.BatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinboard - Open Board"
        Width="320"
        Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PickerBackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="PickerBackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PickerTextBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="PickerBorderBrush" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="Choose a saved batch"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PickerTextBrush}"
                   Margin="0,0,0,12"/>

        <!-- BATCH LIST -->
        <ListBox Grid.Row="1"
                 x:Name="BatchListBox"
                 FontSize="13"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource PickerBorderBrush}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   Foreground="{DynamicResource PickerTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                HorizontalAlignment="Right"
                                Width="24" Height="24"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="Delete this batch"
                                Click="DeleteBatch_Click">
                            <TextBlock x:Name="TrashIcon"
                                       Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource PickerTextBrush}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OpenButton"
                    Content="Open"
                    Width="64" Height="26"
                    FontSize="12"
                    Margin="0,0,6,0"
                    Click="OpenButton_Click"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="64" Height="26"
                    FontSize="12"
                    Margin="0,0,6,0"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Width="64" Height="26"
                    FontSize="12"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
