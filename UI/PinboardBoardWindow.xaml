<Window x:Class="Pinboard.UI.PinboardBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinboard"
        Width="1100"
        Height="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BoardBackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#ECECEC"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="CardHeaderBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="CardHeaderTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BatchLabelBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="ResizeHandleBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="GridDotBrush" Color="#B5B5B5"/>

        <!-- Flat icon only toggle, no square chrome, just a soft hover highlight,
             a bit stronger while checked. -->
        <Style x:Key="FlatIconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#3A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat icon only button, no square chrome, just a soft hover highlight.
             No functionality wired up yet, placeholders only for now. -->
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#3A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="BatchNameText"
                       Text=""
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource BatchLabelBrush}"
                       VerticalAlignment="Center"/>

            <!-- Color and thickness, shown while the pen is active, hides itself
                 automatically the moment a stroke actually starts. Own column,
                 not a manually guessed margin, so it can never overlap the
                 button row next to it regardless of exact sizes. -->
            <Border x:Name="PenOptionsPanel"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                            Background="#E74C3C" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_MouseLeftButtonDown"/>
                    <Border Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                            Background="#2C3E50" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_MouseLeftButtonDown"/>
                    <Border Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                            Background="#3498DB" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_MouseLeftButtonDown"/>
                    <Border Width="20" Height="20" Margin="0,0,6,0" CornerRadius="3"
                            Background="#27AE60" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_MouseLeftButtonDown"/>
                    <Border Width="20" Height="20" Margin="0,0,10,0" CornerRadius="3"
                            Background="#F39C12" Cursor="Hand"
                            MouseLeftButtonDown="ColorSwatch_MouseLeftButtonDown"/>
                    <Slider x:Name="ThicknessSlider"
                            Width="90"
                            VerticalAlignment="Center"
                            Minimum="1" Maximum="12" Value="3"
                            IsMoveToPointEnabled="True"
                            ValueChanged="ThicknessSlider_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- Edit, select, pen, eraser, print, evenly spaced -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="EditSchedulesButton"
                        Style="{StaticResource FlatIconButton}"
                        Width="40" Height="36"
                        Margin="0,0,10,0"
                        ToolTip="Add or remove schedules on this board"
                        Click="EditSchedulesButton_Click">
                    <Image x:Name="EditIcon"
                           Source="pack://application:,,,/Pinboard;component/Resources/tool_edit.png"
                           Width="22" Height="22"/>
                </Button>
                <ToggleButton x:Name="SelectButton"
                              Style="{StaticResource FlatIconToggleButton}"
                              Width="40" Height="36"
                              Margin="0,0,10,0"
                              ToolTip="Select and move markup"
                              Click="SelectButton_Click">
                    <Image x:Name="SelectIcon"
                           Source="pack://application:,,,/Pinboard;component/Resources/tool_select.png"
                           Width="22" Height="22"/>
                </ToggleButton>
                <ToggleButton x:Name="PenButton"
                              Style="{StaticResource FlatIconToggleButton}"
                              Width="40" Height="36"
                              Margin="0,0,10,0"
                              ToolTip="Pen"
                              Click="PenButton_Click">
                    <Image x:Name="PenIcon"
                           Source="pack://application:,,,/Pinboard;component/Resources/tool_pen.png"
                           Width="22" Height="22"/>
                </ToggleButton>
                <ToggleButton x:Name="EraserButton"
                              Style="{StaticResource FlatIconToggleButton}"
                              Width="40" Height="36"
                              Margin="0,0,10,0"
                              ToolTip="Eraser"
                              Click="EraserButton_Click">
                    <Image x:Name="EraserIcon"
                           Source="pack://application:,,,/Pinboard;component/Resources/tool_eraser.png"
                           Width="22" Height="22"/>
                </ToggleButton>
                <Button x:Name="PrintButton"
                        Style="{StaticResource FlatIconButton}"
                        Width="40" Height="36"
                        ToolTip="Print or save as PDF"
                        Click="PrintButton_Click">
                    <Image x:Name="PrintIcon"
                           Source="pack://application:,,,/Pinboard;component/Resources/tool_print.png"
                           Width="22" Height="22"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- FREEFORM BOARD, middle drag pans, wheel zooms, middle double click fits all -->
        <!-- The dot pattern lives here, not on the canvas below, so it always fills the
             whole visible viewport and never runs out no matter how far you pan or zoom.
             Its Viewport rectangle gets recalculated in code whenever pan or zoom changes. -->
        <Border Grid.Row="1"
                x:Name="ViewportBorder"
                ClipToBounds="True"
                MouseDown="ViewportBorder_MouseDown"
                MouseMove="ViewportBorder_MouseMove"
                MouseUp="ViewportBorder_MouseUp"
                MouseWheel="ViewportBorder_MouseWheel">
            <Border.Background>
                <DrawingBrush x:Name="GridBrush"
                              TileMode="Tile"
                              ViewportUnits="Absolute"
                              ViewboxUnits="Absolute"
                              Viewbox="0,0,1,1"
                              Viewport="0,0,19,19"
                              Stretch="Fill">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="{DynamicResource GridDotBrush}">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="0.5,0.5" RadiusX="0.055" RadiusY="0.055"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>

            <Grid x:Name="BoardContentHost">
            <ItemsControl x:Name="CardList" RenderTransformOrigin="0,0">
                <ItemsControl.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BoardScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="BoardTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </ItemsControl.RenderTransform>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="15000" Height="10000"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}"
                                Height="{Binding Height}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Drag handle, grab here to move the card, double click opens the real schedule -->
                                <Thumb Grid.Row="0"
                                       Height="28"
                                       Cursor="SizeAll"
                                       DragDelta="HeaderThumb_DragDelta"
                                       DragCompleted="HeaderThumb_DragCompleted"
                                       PreviewMouseLeftButtonDown="HeaderThumb_PreviewMouseLeftButtonDown">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource CardHeaderBrush}" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource CardHeaderTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,10,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <DataGrid Grid.Row="1"
                                          Margin="6"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding DataView}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserReorderColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          FontSize="10"
                                          BorderThickness="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"/>

                                <!-- Right edge, drag to resize width only -->
                                <Thumb Grid.Row="0" Grid.RowSpan="2"
                                       Width="6"
                                       HorizontalAlignment="Right"
                                       Cursor="SizeWE"
                                       DragDelta="RightEdgeThumb_DragDelta"
                                       DragCompleted="RightEdgeThumb_DragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <!-- Bottom edge, drag to resize height only -->
                                <Thumb Grid.Row="1"
                                       Height="6"
                                       VerticalAlignment="Bottom"
                                       Cursor="SizeNS"
                                       DragDelta="BottomEdgeThumb_DragDelta"
                                       DragCompleted="BottomEdgeThumb_DragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <!-- Corner handle, drag to resize width and height together -->
                                <Thumb Grid.Row="1"
                                       Width="14" Height="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Cursor="SizeNWSE"
                                       DragDelta="ResizeThumb_DragDelta"
                                       DragCompleted="ResizeThumb_DragCompleted">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ResizeHandleBrush}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Markup layer, a plain sibling of the cards above, deliberately not
                 wrapped together with them under one shared container. It keeps its
                 own independent transform, kept in sync with the cards' pan and zoom
                 entirely through code, so nothing about the cards' own proven setup
                 is touched by this at all. -->
            <Canvas x:Name="MarkupCanvas"
                    Width="15000" Height="10000"
                    RenderTransformOrigin="0,0"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    MouseLeftButtonDown="MarkupCanvas_MouseLeftButtonDown"
                    MouseMove="MarkupCanvas_MouseMove"
                    MouseLeftButtonUp="MarkupCanvas_MouseLeftButtonUp">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MarkupScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="MarkupTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
